# انسخ هذا الملف إلى .env.local وعبّي القيم. لا ترفع .env.local أبداً.

# رابط الموقع (للمعاينة المحلية)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — مشروع jordan-gym-reviews فقط (يظهر آمناً بالمتصفح)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — للخادم فقط. ممنوع استخدامه بالمتصفح أو بمتغير يبدأ بـ NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# إشعارات المالك (اختياري). تيليجرام: بوت جديد خاص بالمشروع فقط (ليس بوت مشروع آخر)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# أو بريد عبر Resend
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
